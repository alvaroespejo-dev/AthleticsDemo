# Base de la API. En desarrollo apunta a la API local; en producción, al App Service.
# ⚠️ IMPORTANTE: El backend corre en HTTP (no HTTPS) en localhost
# Puerto: 5183 (ver server.port en AEspejo.Inscripciones.Backend/src/main/resources/application.yml)
VITE_API_URL=http://localhost:5183/api

# Base del SPA, de donde cuelgan /inscripcion/{slug}, /portal y /login.
# Puerto: 5173 (ver AEspejo.Inscripciones.Web/vite.config.ts)
VITE_APP_URL=https://localhost:5173
