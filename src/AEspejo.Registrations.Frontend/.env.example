# Copy to .env.local for 
pm run dev. Public values only: anything NEXT_PUBLIC_* ends up in the browser bundle.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
# Where 
ext dev proxies /api/* (static builds ignore this).
DEV_API_ORIGIN=http://localhost:8080
